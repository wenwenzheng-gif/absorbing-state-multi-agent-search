# OpenAI-compatible endpoint used by the LLM-agent experiments (src/agent_system).
# Local vLLM server (see serving/serve_vllm.sh):
OPENAI_API_KEY=EMPTY  # any non-empty string; vLLM does not check it
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=Qwen/Qwen3.5-4B
# Hosted OpenAI API instead:
# OPENAI_API_KEY=<your key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-nano
